# assay configuration for testing Driftline locally.
# Copy to .env (gitignored) and add your key. Run `npm run dev` first.

ANTHROPIC_API_KEY=your-anthropic-api-key-here

ASSAY_BASE_URL=http://localhost:5173/v/clean
ASSAY_LOGIN_URL=http://localhost:5173/v/clean/login
ASSAY_ALLOWED_ORIGINS=http://localhost:5173

# Public demo account (synthetic; works only on Driftline)
ASSAY_TEST_USERNAME=demo@example.com
ASSAY_TEST_PASSWORD=demo1234

# Safe on Driftline only: data is synthetic and stored per browser.
# Never copy this setting to a real application's .env.
ASSAY_ALLOW_MUTATIONS=true

# Optional
# ASSAY_DEPTH=low
# ASSAY_RECORD_VIDEO=true   # save a video per scenario (great for demos)
# ASSAY_HEADLESS=false      # watch the browser while recording a demo
# ASSAY_SLOWMO_MS=400

# Hosted demo instead of local:
# ASSAY_BASE_URL=https://driftline-demo.onrender.com/v/clean
# ASSAY_LOGIN_URL=https://driftline-demo.onrender.com/v/clean/login
# ASSAY_ALLOWED_ORIGINS=https://driftline-demo.onrender.com
